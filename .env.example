# =============================================================================
# Variáveis de ambiente — desenvolvimento local
# =============================================================================
# Copie este arquivo para .env e ajuste os valores conforme necessário.
# O arquivo .env NÃO deve ser commitado (já está no .gitignore).
#
# Uso:
#   cp .env.example .env
#   docker compose up -d
#   cd backend && ./mvnw spring-boot:run
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (Docker Compose)
# Os valores aqui devem casar com DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD.
# -----------------------------------------------------------------------------
POSTGRES_DB=pcp
POSTGRES_USER=pcp
POSTGRES_PASSWORD=pcp_dev

# -----------------------------------------------------------------------------
# Datasource (lido pelo Spring Boot — application.yml)
# Host 5433: mapeamento docker-compose (5433 no host -> 5432 no container).
# Em produção (Render), sobrescreva DB_HOST/DB_PORT com a string do Neon.
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5433
DB_NAME=pcp
DB_USER=pcp
DB_PASSWORD=pcp_dev

# -----------------------------------------------------------------------------
# RabbitMQ (Docker Compose + Spring Boot)
# -----------------------------------------------------------------------------
RABBITMQ_USER=pcp
RABBITMQ_PASSWORD=pcp_dev

# -----------------------------------------------------------------------------
# JWT
# Mínimo 32 caracteres para HS256.
# NUNCA use o valor abaixo em produção — gere um segredo aleatório:
#   openssl rand -hex 32
# -----------------------------------------------------------------------------
JWT_SECRET=troque-este-valor-por-uma-chave-aleatoria-com-32-chars-ou-mais
JWT_EXPIRACAO_MS=28800000

# -----------------------------------------------------------------------------
# OpenAI (usado pela Fase 5 — módulo de IA)
# Obtenha sua chave em https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...