# Copie este arquivo para `.env` e ajuste os valores.
# O arquivo `.env` NUNCA é versionado no Git (ver .gitignore).

# PostgreSQL (banco de dados)
POSTGRES_DB=pcp
POSTGRES_USER=pcp
POSTGRES_PASSWORD=troque-esta-senha

# RabbitMQ (mensageria)
RABBITMQ_USER=pcp
RABBITMQ_PASSWORD=troque-esta-senha

# JWT (autenticação — Fase 2)
# Mínimo 32 caracteres. Gere um valor seguro em produção:
#   openssl rand -base64 48
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria-em-producao
# Expiração do token em milissegundos (padrão: 8 horas)
JWT_EXPIRACAO_MS=28800000

# OpenAI (módulo de IA — usado a partir da Fase 5)
# Obtenha em https://platform.openai.com/api-keys
OPENAI_API_KEY=
