# Copie para .env.local e ajuste conforme necessário.
# O Vite injeta variáveis VITE_* em tempo de build.

# URL base da API (deixe vazio para usar o proxy do Vite em dev)
# Em produção no Vercel, aponte para o backend no Render:
# VITE_API_BASE_URL=https://pcp-backend.onrender.com/api
VITE_API_BASE_URL=
