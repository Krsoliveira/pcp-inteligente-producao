{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "import", "vitest"],
  "categories": { "correctness": "error" },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "no-console": "error",
    "eqeqeq": ["error", "smart"],

    // Copiar a URL ou o registro para o formulário em efeito pinta a tela com o valor antigo: use useSincronizarAoMudar.
    "react/set-state-in-effect": "error",

    // Pede <output> e <img> onde o papel está num Box do MUI ao redor de um canvas: não se aplica.
    "jsx-a11y/prefer-tag-over-role": "off",
    // O foco inicial é intencional: login, filtro da coluna e primeiro campo de diálogo têm uma tarefa só.
    "jsx-a11y/no-autofocus": "off",
    // vi.fn() sem tipo é o padrão dos testes, tipados por vi.mocked.
    "vitest/require-mock-type-parameters": "off"
  },
  "ignorePatterns": ["dist", "node_modules"]
}
